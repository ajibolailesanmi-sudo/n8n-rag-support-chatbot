      "parameters": {
        "content": "## 11 - WhatsApp\nMeta signs every webhook; n8n checks the signature with the app secret. Each text message goes to 20 - Answer Message and the reply is sent back on WhatsApp. Redelivered messages are ignored, and voice notes or images get a short text-only notice.",
        "height": 180,
        "width": 560,
        "color": 4
      },
      "id": "26672741-d3f7-56a8-a290-cb05baff4e3a",
      "name": "About",

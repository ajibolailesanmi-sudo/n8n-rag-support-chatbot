    {
      "parameters": {
        "jsCode": "// Upsert Items: one item per article to (re)embed.\nreturn $('Plan Sync').first().json.upserts.map((u) => ({ json: u }));\n"
      },
      "id": "681d7162-8b36-5d19-ae23-e018754465a2",
      "name": "Upsert Items",

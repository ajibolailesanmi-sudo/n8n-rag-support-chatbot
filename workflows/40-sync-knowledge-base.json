      "id": "614ce1e7-74ea-58fe-9884-3acfd4af53fa",
      "name": "Download Article",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        2860,
        260
      ],
      "credentials": {
        "googleApi": {
          "id": "scGoogleSACred01",
          "name": "Google Service Account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Prepare Article: reads each exported Google Doc (Markdown), tidies it and fingerprints it.\nconst metas = $('Upsert Items').all().map((i) => i.json);\nconst items = $input.all();\n\n// FNV-1a, 32-bit, twice with different seeds: enough to tell whether an article changed.\nfunction fnv(str, seed) {\n  let h = seed >>> 0;\n  for (let i = 0; i < str.length; i++) {\n    h ^= str.charCodeAt(i);\n    h = Math.imul(h, 16777619) >>> 0;\n  }\n  return h.toString(16).padStart(8, '0');\n}\n\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const meta = metas[i] || {};\n  let text = '';\n  try {\n    const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n    text = buf.toString('utf8');\n  } catch (e) {\n    text = '';\n  }\n  // Google's Markdown export escapes characters (\\$65) and bolds headings (# **Title**).\n  text = text\n    .replace(/\\r\\n/g, '\\n')\n    .replace(/\\\\([\\\\`*_{}\\[\\]()#+\\-.!$|>~])/g, '$1')\n    .replace(/\\*\\*(.+?)\\*\\*/g, '$1')\n    .replace(/\\n\\n(\\* |\\d+\\. )/g, '\\n$1')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim();\n  if (!text) continue;\n  const fingerprint = fnv(`${meta.title}\\n${text}`, 2166136261) + fnv(text, 33554467);\n  out.push({ json: { ...meta, text, hash: fingerprint, chars: text.length } });\n}\nreturn out;\n"
      },
      "id": "6c996658-55ab-527a-8101-0a3f10d1ef10",
      "name": "Prepare Article",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        260
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/documents?file_id=eq.{{ encodeURIComponent($json.file_id) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "options": {}
      },
      "id": "d7c953f4-9f94-56b1-b67f-b1a7b1d69cc1",
      "name": "Remove Old Chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3300,
        260
      ],
      "credentials": {
        "supabaseApi": {
          "id": "scSupabaseCred01",
          "name": "Supabase - Support Chatbot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Chunk Articles: splits each article into chunks of about chunk_size characters, breaking at\n// headings first, then paragraphs, then lines, with an overlap so a fact split across two chunks\n// is still found. Builds the batch embedding request for Gemini (one request per article).\nconst settings = $('Settings').first().json.settings || {};\nconst CHUNK = parseInt(settings.chunk_size, 10) || 900;\nconst OVERLAP = parseInt(settings.chunk_overlap, 10) || 120;\nconst DIMS = parseInt(settings.embedding_dimensions, 10) || 1536;\nconst MODEL = settings.embedding_model || 'gemini-embedding-001';\n\nfunction splitRecursive(text, separators) {\n  if (text.length <= CHUNK) return [text];\n  const [sep, ...rest] = separators;\n  if (sep === undefined) {\n    const out = [];\n    for (let i = 0; i < text.length; i += CHUNK) out.push(text.slice(i, i + CHUNK));\n    return out;\n  }\n  const pieces = text.split(sep).map((s, i) => (i === 0 ? s : sep + s)).filter((s) => s.trim());\n  const out = [];\n  let current = '';\n  for (const piece of pieces) {\n    const candidate = current ? current + piece : piece;\n    if (candidate.length <= CHUNK) {\n      current = candidate;\n      continue;\n    }\n    if (current) out.push(current);\n    if (piece.length > CHUNK) {\n      const sub = splitRecursive(piece, rest);\n      out.push(...sub.slice(0, -1));\n      current = sub[sub.length - 1];\n    } else {\n      current = piece;\n    }\n  }\n  if (current) out.push(current);\n  return out;\n}\n\nfunction withOverlap(chunks) {\n  return chunks.map((c, i) => {\n    if (i === 0 || OVERLAP <= 0) return c.trim();\n    const prev = chunks[i - 1];\n    const tail = prev.slice(Math.max(0, prev.length - OVERLAP));\n    const cut = tail.search(/\\s/);\n    return ((cut >= 0 ? tail.slice(cut + 1) : tail) + '\\n' + c).trim();\n  });\n}\n\n// Remove Old Chunks outputs the delete responses, so the articles are read from Prepare Article.\nconst out = [];\nfor (const item of $('Prepare Article').all()) {\n  const a = item.json;\n  const pieces = withOverlap(splitRecursive(a.text, ['\\n## ', '\\n### ', '\\n\\n', '\\n', ' ']));\n  const chunks = pieces.filter((c) => c.length > 20);\n  out.push({\n    json: {\n      ...a,\n      chunks,\n      embed_body: {\n        requests: chunks.map((c) => ({\n          model: `models/${MODEL}`,\n          content: { parts: [{ text: `${a.title}\\n${c}` }] },\n          taskType: 'RETRIEVAL_DOCUMENT',\n          title: a.title,\n          outputDimensionality: DIMS,\n        })),\n      },\n    },\n  });\n}\nreturn out;\n"
      },
      "id": "2425cdbc-2471-57af-8466-e1750956ef59",
      "name": "Chunk Articles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        260
      ]
    },
    {
      "parameters": {

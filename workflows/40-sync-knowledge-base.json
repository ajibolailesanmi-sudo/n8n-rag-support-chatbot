      "id": "036aaf50-5a1f-5e70-b0c0-4475b0d11268",
      "name": "Embed Chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3740,
        260
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "scGeminiHdrCred1",
          "name": "Gemini - Support Chatbot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Build Rows: pairs each chunk with its embedding and prepares the rows for the documents table.\nconst articles = $('Chunk Articles').all().map((i) => i.json);\nconst out = [];\nfor (let i = 0; i < $input.all().length; i++) {\n  const res = $input.all()[i].json || {};\n  const a = articles[i];\n  const embeddings = Array.isArray(res.embeddings) ? res.embeddings : [];\n  if (!a) throw new Error(`No article for embedding result ${i}`);\n  if (embeddings.length !== a.chunks.length) {\n    throw new Error(`\"${a.title}\": ${a.chunks.length} chunks but ${embeddings.length} embeddings came back`);\n  }\n  const rows = a.chunks.map((content, idx) => ({\n    content,\n    metadata: { file_id: a.file_id, title: a.title, url: a.url, content_hash: a.hash, chunk_index: idx },\n    embedding: embeddings[idx].values,\n  }));\n  out.push({ json: { file_id: a.file_id, title: a.title, url: a.url, modified_time: a.modified_time, hash: a.hash, rows, chunk_count: rows.length } });\n}\nreturn out;\n"
      },
      "id": "b34fad39-863b-5c3e-833d-dba8d740f872",
      "name": "Build Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3960,
        260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabase_url }}/rest/v1/documents",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.rows) }}",
        "options": {}
      },
      "id": "17ffe8b4-2ae1-563a-921c-b5085633f9fc",
      "name": "Store Chunks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4180,
        260
      ],
      "credentials": {
        "supabaseApi": {
          "id": "scSupabaseCred01",
          "name": "Supabase - Support Chatbot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Count Chunks: one kb_files row per embedded article, with its chunk count.\nconst now = new Date().toISOString();\nconst rows = $('Build Rows').all().map((i) => i.json).map((a) => ({\n  file_id: a.file_id,\n  title: a.title,\n  url: a.url,\n  modified_time: a.modified_time,\n  content_hash: a.hash,\n  chunk_count: a.chunk_count,\n  synced_at: now,\n}));\nreturn [{ json: { rows, chunks_written: rows.reduce((sum, r) => sum + r.chunk_count, 0) } }];\n"

{
  "name": "10 - Website Chat",
  "nodes": [
    {
      "parameters": {
        "content": "## 10 - Website Chat\nPublic chat for the website widget and the hosted chat page. Allowed origins limit which websites can embed it. Every message goes to 20 - Answer Message; if that fails, the visitor still gets a polite reply.",
        "height": 180,
        "width": 520,
        "color": 4
      },
      "id": "d223e560-36a4-5834-abe6-13d3a8b40005",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -20
      ]
    },
    {
      "parameters": {
        "public": true,
        "mode": "hostedChat",
        "authentication": "none",
        "initialMessages": "Hi! I'm the help desk assistant for this sample IT services firm.\nAsk me about passwords, MFA, the VPN, email, billing, plans or support hours. If I can't help, I'll pass you to a person.",
        "options": {
          "allowedOrigins": "*",
          "title": "IT Help Desk",
          "subtitle": "Sample help centre. Solvant Labs demo build.",
          "inputPlaceholder": "Ask about passwords, VPN, billing...",
          "loadPreviousSession": "notSupported",
          "responseMode": "lastNode",
          "customCss": ":root {\n  --chat--color--primary: #1f6feb;\n  --chat--color--primary-shade-50: #1a5fcc;\n  --chat--color--primary--shade-100: #154fa8;\n  --chat--color--secondary: #101820;\n  --chat--color-secondary-shade-50: #0b1117;\n  --chat--color-white: #ffffff;\n  --chat--color-light: #f7f8f6;\n  --chat--color-light-shade-50: #eceee9;\n  --chat--color-light-shade-100: #dfe3e8;\n  --chat--color-medium: #c9ced4;\n  --chat--color-dark: #101820;\n  --chat--color-disabled: #8a929b;\n  --chat--color-typing: #5b6470;\n  --chat--font-family: Inter, 'Segoe UI', system-ui, sans-serif;\n  --chat--header--background: #101820;\n  --chat--header--color: #f7f8f6;\n  --chat--message--bot--background: #ffffff;\n  --chat--message--bot--color: #101820;\n  --chat--message--user--background: #1f6feb;\n  --chat--message--user--color: #ffffff;\n}"
        }
      },

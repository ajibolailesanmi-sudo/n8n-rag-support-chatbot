# Copy to .env (never commit .env)
# A long random string; n8n encrypts stored credentials with it. Keep it: changing it makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
GENERIC_TIMEZONE=America/New_York
# Leave as localhost for a PC-only demo. With a Cloudflare tunnel, set the three below to the tunnel address, for example
# N8N_HOST=assistant.example.com  N8N_PROTOCOL=https  WEBHOOK_URL=https://assistant.example.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
